{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CareForms Form Definition Schema v1",
  "description": "Canonical schema for data-driven CareForms form definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "category", "version", "sections"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1, "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "category": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string", "maxLength": 2000 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 64 },
      "uniqueItems": true
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "icon": { "type": "string", "maxLength": 64 },
        "accent": { "type": "string", "maxLength": 32 }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "fields"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1, "maxLength": 128 },
          "label": { "type": "string", "minLength": 1, "maxLength": 255 },
          "description": { "type": "string", "maxLength": 2000 },
          "collapsible": { "type": "boolean", "default": false },
          "logic": { "$ref": "#/definitions/visibilityLogic" },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "type", "label"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "minLength": 1, "maxLength": 128 },
                "type": { "type": "string", "enum": ["text", "number", "date", "time", "textarea", "checkbox", "checkbox-group", "choice-group", "signature"] },
                "label": { "type": "string", "minLength": 1, "maxLength": 255 },
                "required": { "type": "boolean", "default": false },
                "helpText": { "type": "string", "maxLength": 1000 },
                "placeholder": { "type": "string", "maxLength": 255 },
                "unit": { "type": "string", "maxLength": 32 },
                "width": { "type": "string", "enum": ["full", "half", "third"] },
                "readOnly": { "type": "boolean", "default": false },
                "source": {
                  "type": "string",
                  "enum": ["manual", "patient.name", "patient.mr_number", "patient.date_of_birth", "current_user.display_name", "system.current_date"]
                },
                "logic": { "$ref": "#/definitions/fieldLogic" },
                "validation": { "$ref": "#/definitions/fieldValidation" },
                "calculation": { "$ref": "#/definitions/calculation" },
                "optionDependency": { "$ref": "#/definitions/optionDependency" },
                "options": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1, "maxLength": 255 },
                  "uniqueItems": true
                },
                "min": { "type": "number" },
                "max": { "type": "number" },
                "step": { "type": "number", "exclusiveMinimum": 0 },
                "minLength": { "type": "integer", "minimum": 0 },
                "maxLength": { "type": "integer", "minimum": 0 },
                "pattern": { "type": "string", "minLength": 1, "maxLength": 1000 },
                "validationMessage": { "type": "string", "minLength": 1, "maxLength": 1000 },
                "rows": { "type": "integer", "minimum": 1, "maximum": 50 },
                "defaultValue": {}
              },
              "allOf": [
                {
                  "if": { "properties": { "type": { "const": "number" } }, "required": ["type"] },
                  "else": { "not": { "anyOf": [{ "required": ["min"] }, { "required": ["max"] }, { "required": ["step"] }] } }
                },
                {
                  "if": { "properties": { "type": { "enum": ["text", "textarea"] } }, "required": ["type"] },
                  "else": { "not": { "anyOf": [{ "required": ["minLength"] }, { "required": ["maxLength"] }, { "required": ["pattern"] }, { "required": ["validationMessage"] }] } }
                },
                {
                  "if": { "required": ["validationMessage"] },
                  "then": { "required": ["pattern"] }
                },
                {
                  "if": { "required": ["calculation"] },
                  "then": {
                    "properties": {
                      "type": { "const": "number" },
                      "readOnly": { "const": true }
                    },
                    "required": ["readOnly"]
                  }
                },
                {
                  "if": { "required": ["optionDependency"] },
                  "then": {
                    "properties": {
                      "type": { "enum": ["choice-group", "checkbox-group"] }
                    },
                    "required": ["options"]
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "definitions": {
    "visibilityLogic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["showWhen"],
      "properties": {
        "showWhen": { "$ref": "#/definitions/visibilityRule" }
      }
    },
    "fieldLogic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "showWhen": { "$ref": "#/definitions/visibilityRule" },
        "requiredWhen": { "$ref": "#/definitions/visibilityRule" }
      },
      "anyOf": [
        { "required": ["showWhen"] },
        { "required": ["requiredWhen"] }
      ]
    },
    "visibilityRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator"],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "minLength": 1,
          "maxLength": 128
        },
        "operator": {
          "type": "string",
          "enum": ["equals", "notEquals", "isEmpty", "isNotEmpty", "contains"]
        },
        "value": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": { "enum": ["equals", "notEquals", "contains"] }
            },
            "required": ["operator"]
          },
          "then": { "required": ["value"] }
        },
        {
          "if": {
            "properties": {
              "operator": { "enum": ["isEmpty", "isNotEmpty"] }
            },
            "required": ["operator"]
          },
          "then": { "not": { "required": ["value"] } }
        }
      ]
    },
    "fieldValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compare"],
      "properties": {
        "compare": { "$ref": "#/definitions/comparisonRule" }
      }
    },
    "comparisonRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "message"],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "minLength": 1,
          "maxLength": 128
        },
        "operator": {
          "type": "string",
          "enum": ["equals", "notEquals", "greaterThan", "greaterThanOrEqual", "lessThan", "lessThanOrEqual"]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression"],
      "properties": {
        "expression": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "precision": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "optionDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "rules"],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "minLength": 1,
          "maxLength": 128
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "options"],
            "properties": {
              "value": { "type": "string", "minLength": 1, "maxLength": 255 },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1, "maxLength": 255 },
                "uniqueItems": true
              }
            }
          }
        }
      }
    }
  }
}
