{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CareForms Form Definition Schema v1",
  "description": "Canonical schema for data-driven CareForms form definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "category", "version", "sections"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1, "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "category": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string", "maxLength": 2000 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 64 },
      "uniqueItems": true
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "icon": { "type": "string", "maxLength": 64 },
        "accent": { "type": "string", "maxLength": 32 }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "fields"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1, "maxLength": 128 },
          "label": { "type": "string", "minLength": 1, "maxLength": 255 },
          "description": { "type": "string", "maxLength": 2000 },
          "collapsible": { "type": "boolean", "default": false },
          "logic": { "$ref": "#/definitions/visibilityLogic" },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "type", "label"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "minLength": 1, "maxLength": 128 },
                "type": { "type": "string", "enum": ["text", "number", "date", "time", "textarea", "checkbox", "checkbox-group", "choice-group", "signature"] },
                "label": { "type": "string", "minLength": 1, "maxLength": 255 },
                "required": { "type": "boolean", "default": false },
                "helpText": { "type": "string", "maxLength": 1000 },
                "placeholder": { "type": "string", "maxLength": 255 },
                "unit": { "type": "string", "maxLength": 32 },
                "width": { "type": "string", "enum": ["full", "half", "third"] },
                "readOnly": { "type": "boolean", "default": false },
                "source": {
                  "type": "string",
                  "enum": ["manual", "patient.name", "patient.mr_number", "patient.date_of_birth", "current_user.display_name", "system.current_date"]
                },
                "logic": { "$ref": "#/definitions/visibilityLogic" },
                "options": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1, "maxLength": 255 },
                  "uniqueItems": true
                },
                "min": { "type": "number" },
                "max": { "type": "number" },
                "rows": { "type": "integer", "minimum": 1, "maximum": 50 },
                "defaultValue": {}
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "visibilityLogic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["showWhen"],
      "properties": {
        "showWhen": { "$ref": "#/definitions/visibilityRule" }
      }
    },
    "visibilityRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator"],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "minLength": 1,
          "maxLength": 128
        },
        "operator": {
          "type": "string",
          "enum": ["equals", "notEquals", "isEmpty", "isNotEmpty", "contains"]
        },
        "value": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": { "enum": ["equals", "notEquals", "contains"] }
            },
            "required": ["operator"]
          },
          "then": { "required": ["value"] }
        },
        {
          "if": {
            "properties": {
              "operator": { "enum": ["isEmpty", "isNotEmpty"] }
            },
            "required": ["operator"]
          },
          "then": { "not": { "required": ["value"] } }
        }
      ]
    }
  }
}
